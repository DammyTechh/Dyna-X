{
  "expo": {
    "name": "DynaX Scanner",
    "slug": "dynax-scanner-mobile",
    "scheme": "dynaxscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dynax.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "DynaX Scanner uses the camera to capture a short orbit video of the anatomy for 3D reconstruction.",
        "NSMicrophoneUsageDescription": "Audio is not recorded; the camera module may request microphone access.",
        "NSPhotoLibraryUsageDescription": "Select a previously recorded capture video to reconstruct."
      }
    },
    "android": {
      "package": "app.dynax.scanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DynaX Scanner to use the camera to capture a scan video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DynaX Scanner to select a capture video."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ]
  }
}