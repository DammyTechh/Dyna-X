# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_NAME=DynaX API
APP_VERSION=1.0.0
# Used to build links in transactional emails
FRONTEND_URL=https://dynax.app

# ─── Supabase / Database ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# IMPORTANT: use the Supabase CONNECTION POOLER, not the direct connection.
# The direct host (db.<ref>.supabase.co) is IPv6-only and is unreachable from
# Docker / most networks. Copy the "Session pooler" URI from your Supabase
# dashboard: Project -> Connect -> Session pooler. It looks like this
# (note the username is postgres.<project-ref>, host ends in pooler.supabase.com):
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Percent-encode special characters in the password (@ -> %40, # -> %23, etc.).
DATABASE_URL=postgres://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# ─── Redis (rate limiting & session store) ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@dynalimb.com
RESEND_FROM_NAME=DynaX Platform

# ─── AI (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ─── Storage (Supabase Storage) ───────────────────────────────────────────────
STORAGE_BUCKET_DOCS=dynax-documents
STORAGE_BUCKET_DEVICES=dynax-devices
STORAGE_BUCKET_AVATARS=dynax-avatars

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_COST=12
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dynax.app,https://www.dynax.app,https://dyna-x.netlify.app

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
