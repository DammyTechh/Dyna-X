# ─── DynaX Frontend — Environment Variables ──────────────────────────────────
# Copy this to .env.local for local dev, or set these in your Vercel project.

# Go backend base URL (NO trailing slash). Must include /api/v1.
# Local:       http://localhost:8080/api/v1
# Production:  https://dyna-x.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# App identity + the public URL of THIS frontend (used for share links).
# Local:       http://localhost:3000
# Production:  https://dynax.app
NEXT_PUBLIC_APP_NAME=DynaX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (only needed for direct browser storage uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
